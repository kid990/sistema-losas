VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_UNHEVAL_URL=http://localhost:3001/api

# React Router SSR usa el nombre interno del servicio dentro de Docker.
API_INTERNAL_BASE_URL=http://backend-fastapi:3000/api
HOST=0.0.0.0
PORT=5173
NODE_ENV=production
