# Puertos publicados únicamente en localhost
FRONTEND_PORT=5173
BACKEND_FASTAPI_PORT=3000
BACKEND_API_PORT=3001
POSTGRES_PORT_HOST=5432
MYSQL_PORT_HOST=3306
REDIS_PORT_HOST=6379
FLOWER_PORT=5555

# Entrada pública utilizada por docker/compose.production.yml
PUBLIC_URL=https://sirlod.example.com
NGINX_HTTP_PORT=80

# PostgreSQL local opcional (--profile local-db). FastAPI usa Supabase por defecto.
POSTGRES_USER=sirlod
POSTGRES_PASSWORD=postgres_dev_change_me
POSTGRES_DB=losa
LOAD_DEMO_DATA=false

# MySQL del padrón UNHEVAL utilizado por backend_api
MYSQL_ROOT_PASSWORD=mysql_root_dev_change_me
MYSQL_DATABASE=api_unheval
MYSQL_USER=unheval
MYSQL_PASSWORD=mysql_dev_change_me

# Redis y Flower
REDIS_PASSWORD=redis_dev_change_me
FLOWER_USER=admin
FLOWER_PASSWORD=flower_dev_change_me
