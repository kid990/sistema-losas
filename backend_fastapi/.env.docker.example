APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000

# Copia desde Supabase > Connect la URL Direct o Session pooler (puerto 5432).
# Cambia el esquema postgresql:// por postgresql+asyncpg:// y codifica los
# caracteres especiales de la contraseña. No uses Transaction pooler :6543.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:CHANGE_ME@POOLER_HOST:5432/postgres
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30

JWT_SECRET=development_access_secret_change_me_32
JWT_REFRESH_SECRET=development_refresh_secret_change_me_32
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
UNHEVAL_API_URL=http://backend-api:3001/api

QUEUE_ENABLED=true
REDIS_URL=redis://:${REDIS_PASSWORD:-redis_dev_change_me}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD:-redis_dev_change_me}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD:-redis_dev_change_me}@redis:6379/1
CELERY_TASK_TIME_LIMIT_SECONDS=900
CELERY_RESULT_EXPIRES_SECONDS=86400
QUEUE_FAIL_OPEN=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=
S3_KEY_PREFIX=documentos
S3_IMAGE_KEY_PREFIX=imagenes
S3_DOCUMENT_KEY_PREFIX=documentos
S3_REPORT_KEY_PREFIX=reportes
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_EXPIRES_SECONDS=900

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@unheval.edu
MAIL_LOG_FILE=/app/runtime/mail.log

RENIEC_API_TOKEN=
RENIEC_API_URL=

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

DOCUMENT_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DOCUMENT_AI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DOCUMENT_AI_MIN_CONFIDENCE=0.85
