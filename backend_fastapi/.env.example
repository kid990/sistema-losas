APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000

# Base PostgreSQL creada previamente con el nombre "losa".
DATABASE_URL=postgresql+asyncpg://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/losa
DATABASE_SSL_MODE=disable
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30

JWT_SECRET=cambia_por_una_clave_segura_de_al_menos_32_caracteres
JWT_REFRESH_SECRET=cambia_por_otra_clave_segura_de_al_menos_32_caracteres
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]
UNHEVAL_API_URL=http://localhost:3001/api

# Redis y colas Celery. Activa QUEUE_ENABLED cuando Redis y el worker estén disponibles.
QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TIME_LIMIT_SECONDS=900
CELERY_RESULT_EXPIRES_SECONDS=86400
QUEUE_FAIL_OPEN=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=
S3_KEY_PREFIX=documentos
S3_IMAGE_KEY_PREFIX=imagenes
S3_DOCUMENT_KEY_PREFIX=documentos
S3_REPORT_KEY_PREFIX=reportes
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_EXPIRES_SECONDS=900

MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_LOG_FILE=mail.log

RENIEC_API_TOKEN=
RENIEC_API_URL=

# Chatbot y Reportes: DeepSeek (o gemini / openai)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Revisión de Documentos PDF: OpenAI (o gemini)
DOCUMENT_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DOCUMENT_AI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

DOCUMENT_AI_MIN_CONFIDENCE=0.85
