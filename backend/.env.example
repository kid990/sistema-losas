# ============================================================
# BACKEND-LOSA-JS - Express + JavaScript + MySQL2
# Copia este archivo como .env y completa los valores
# ============================================================

# -------------------- SERVIDOR --------------------
NODE_ENV=development
PORT=3000

# -------------------- BASE DE DATOS (MySQL) --------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_losa

# -------------------- JWT / TOKENS (minimo 32 caracteres) --------------------
JWT_SECRET=cambia_por_una_clave_segura_de_32_caracteres
JWT_REFRESH_SECRET=cambia_por_otra_clave_secreta_para_refresh_32_car
COOKIE_SECRET=cambia_por_clave_para_firmar_cookies_32_caracteres
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DIAS=7

# -------------------- FRONTEND / CORS --------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
UNHEVAL_API_URL=http://localhost:3001/api

# -------------------- S3 / BACKBLAZE B2 --------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=
S3_KEY_PREFIX=documentos
S3_IMAGE_KEY_PREFIX=imagenes
S3_DOCUMENT_KEY_PREFIX=documentos
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_EXPIRES_SECONDS=900

# -------------------- CORREO SMTP --------------------
# Si se deja vacío, el correo se registra localmente.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_LOG_FILE=mail.log

# -------------------- RENIEC / API DE CONSULTAS PERU --------------------
RENIEC_API_TOKEN=
RENIEC_API_URL=
